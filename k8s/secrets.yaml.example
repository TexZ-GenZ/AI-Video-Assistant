# Template — do NOT commit real keys. apply.sh generates the live secret
# from ../.env, so this file exists only to document the shape.
apiVersion: v1
kind: Secret
metadata:
  name: videosense-secrets
  namespace: default
type: Opaque
stringData:
  MISTRAL_API_KEY: "your-mistral-api-key"
  SARVAM_API_KEY: "your-sarvam-api-key"   # only needed for Hindi jobs
