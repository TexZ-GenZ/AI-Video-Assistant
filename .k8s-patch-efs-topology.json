[
  {
    "op": "replace",
    "path": "/spec/template/spec/containers/1/args",
    "value": [
      "--csi-address=$(ADDRESS)",
      "--v=2",
      "--extra-create-metadata",
      "--leader-election",
      "--leader-election-renew-deadline=10s",
      "--leader-election-lease-duration=15s",
      "--worker-threads=100",
      "--timeout=15s"
    ]
  }
]
