FROM python:3.13-slim

WORKDIR /app

COPY requirements-summarization.txt .
RUN pip install --no-cache-dir -r requirements-summarization.txt

COPY shared/ shared/
COPY services/ services/

ENV PYTHONUNBUFFERED=1

# Default: API. Override with `python -m services.summarization.worker` for the worker.
CMD ["uvicorn", "services.summarization.app:app", "--host", "0.0.0.0", "--port", "8002"]
